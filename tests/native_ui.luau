Drawing=nil; getcustomasset=nil; getsynasset=nil
local app=assert(loadstring(SOURCES['main.lua']))()
local ui=app.Library
local function option(name) return assert(ui.options[name],name) end
local toggle=option('ESP_Enabled')
toggle.Control.Activated:Fire()
assert(app.Config.ESP.Enabled,'actual toggle click')
local radius=option('Aim_Radius')
radius.Input.Text='245'; radius.Input.FocusLost:Fire()
assert(app.Config.Aim.Radius==245,'numeric slider input')
radius.Input.Text='invalid'; radius.Input.FocusLost:Fire()
assert(app.Config.Aim.Radius==245,'invalid numeric input does not corrupt settings')
local color=option('Colors_Fill')
color.Hex.Text='#12ABEF'; color.Hex.FocusLost:Fire()
assert(math.abs(app.Config.Colors.Fill.R-18/255)<1e-8 and math.abs(app.Config.Colors.Fill.G-171/255)<1e-8,'HEX input')
color.Channels[1].Text='255'; color.Channels[2].Text='0'; color.Channels[3].Text='100'; color.Channels[1].FocusLost:Fire()
assert(app.Config.Colors.Fill.R==1 and app.Config.Colors.Fill.G==0,'RGB channels')
color:SetTrans(0.4)
assert(app.Config.Alpha.Colors_Fill==0.6,'color opacity')
local mode=option('Aim_Mode')
mode.Control.Activated:Fire()
assert(app.Config.Aim.Mode=='Toggle','selection click cycles modes')
local bind=option('Aim_Key')
bind.Control.Activated:Fire()
MOCK.services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.H,UserInputType=Enum.UserInputType.Keyboard},false)
assert(app.Config.Aim.Key==Enum.KeyCode.H and not ui:IsInteracting(),'key capture')
MOCK.services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.RightShift,UserInputType=Enum.UserInputType.Keyboard},true)
assert(not ui.open,'menu hotkey survives game-processed input')
MOCK.services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.RightShift,UserInputType=Enum.UserInputType.Keyboard},true)
assert(ui.open,'menu hotkey reopens')
ui:SetOpen(false)
assert(not ui.windows[1].Frame.Visible and ui.Reopen.Visible and ui.CompactStatus.Visible,'hide menu and retain aim status')
ui.Reopen.Activated:Fire()
assert(ui.windows[1].Frame.Visible and ui.open,'reopen menu')
ui:SendNotification('Profile saved',10)
ui:SetStatus('Target: @Player2 / Head')
assert(ui.StatusLabel.Text=='Target: @Player2 / Head' and ui.NoticeLabel.Text=='Profile saved','notifications must not hide aim diagnostics')
local camera=workspace.CurrentCamera
local old=camera.ViewportSize
camera.ViewportSize=Vector2.new(500,420)
MOCK.services.RunService.RenderStepped:Fire(1/60)
assert(ui.windows[1].Frame.Size.X.Offset<=476 and ui.windows[1].Frame.Size.Y.Offset<=380,'viewport resize fits screen')
camera.ViewportSize=old
MOCK.services.UserInputService.InputBegan:Fire({KeyCode=Enum.KeyCode.End,UserInputType=Enum.UserInputType.Keyboard},true)
assert(not ui.Alive and ui.Gui.Destroyed and not app.DrawingRenderer.Alive,'processed END key unloads all owned GUI')
local second=assert(loadstring(SOURCES['main.lua']))()
local third=assert(loadstring(SOURCES['main.lua']))()
assert(not second.Alive and third.Alive,'rerun unloads previous instance')
third:Unload()
print('PASS native GUI clicks, numeric/HEX/RGB inputs, opacity, key capture, hide/reopen, viewport resizing and rerun cleanup')
